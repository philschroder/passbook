{
  "name": "passbook",
  "private": true,
  "type": "module",
  "description": "Family savings ledger for kids: balances, weekly allowance, and parent-paid interest on Firebase.",
  "scripts": {
    "test": "npm --prefix functions test",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-passbook \"node test/e2e.mjs\"",
    "dev": "firebase emulators:start --project demo-passbook",
    "deploy": "firebase deploy"
  },
  "devDependencies": {
    "firebase": "^11.0.2"
  }
}
